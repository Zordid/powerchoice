############################################################
# MAKE-Datei für Power-Choice 3.02                         #
#                                                          #
# Benötigte Tools:                                         #
#   TPC.EXE, TASM.EXE, TLINK.EXE, EXE2BIN.EXE TVRM.EXE     #
#                                                          #
############################################################
ASM=ASM        # Assembler Unterverzeichnis
REZ=REZFILES   # Resource Unterverzeichnis
RUN=D:         # EXE-Verzeichnis  

.asm.obj:
  tasm /m3 $<,$*.obj

pchoice.exe: pch*.pas initovr.pas pchoice.rez
  tpc /M /U$(REZ) pchoice.pas
  copy /b $(RUN)\$.+$(RUN)\$&.ovr+$&.rez c:\pchoice\$.

pchoice.rez: $(REZ)\pchstr.rez $(REZ)\pchdlgs.rez $(REZ)\pchoice1.rez
  cd $(REZ)
  tvrm c pchstr+pchdlgs+pchoice1 pchoice
  move pchoice.rez ..
  cd..

$(ASM)\pchpw.sys: $(ASM)\pchpw.obj
  tlink /x $*.obj
  exe2bin $*.exe $<
  del $*.exe

$(ASM)\pchega.com: $(ASM)\pchega.obj
  tlink /t /x $*.obj

